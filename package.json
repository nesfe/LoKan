{
  "name": "lokan",
  "version": "1.3.0",
  "description": "Local kanban board",
  "desktopName": "LoKan",
  "main": "src/main.cjs",
  "author": "LoKan contributors",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist:linux": "electron-builder --linux AppImage --publish never",
    "dist:win": "electron-builder --win nsis --publish never",
    "dist:mac": "electron-builder --mac dmg --publish never"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "app.lokan.desktop",
    "productName": "LoKan",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "LICENSE"
    ],
    "directories": {
      "output": "dist"
    },
    "linux": {
      "category": "Office",
      "icon": "assets/icon.png",
      "syncDesktopName": true,
      "target": [
        "AppImage"
      ]
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis"
      ],
      "signExecutable": false
    },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icon.png",
      "identity": "-",
      "hardenedRuntime": false,
      "target": [
        "dmg"
      ]
    }
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "ssh2": "^1.17.0",
    "zod": "^4.6.7"
  }
}
